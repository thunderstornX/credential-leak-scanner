# credential-leak-scanner — environment template
# Copy to .env and fill in the keys you have. Every key is optional.
# Sources without a key are simply skipped at runtime with a console notice.

# HIBP breached-accounts endpoint (paid, https://haveibeenpwned.com/API/Key)
# Without this, only the k-anonymity Pwned Passwords endpoint runs.
HIBP_API_KEY=

# GitHub PAT for code search (free, https://github.com/settings/tokens)
# A read-only PAT with no scopes is sufficient — code search uses the public
# index. Without this, GitHub dork queries are skipped.
GITHUB_TOKEN=

# Anthropic key for the optional executive summary
# (https://console.anthropic.com/). Without this, --ai-summary degrades to
# a deterministic summary built from the structured findings.
ANTHROPIC_API_KEY=
